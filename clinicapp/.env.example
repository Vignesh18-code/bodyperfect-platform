# Copy values into your process/container environment; Spring does not automatically load .env.
DATABASE_URL=jdbc:postgresql://localhost:5432/clinicapp
DATABASE_USERNAME=clinicapp
DATABASE_PASSWORD=replace-through-secret-manager
JWT_SECRET=generate-at-least-32-random-bytes-outside-source-control
MAIL_USERNAME=configure-provider-account
MAIL_PASSWORD=configure-provider-secret
# Production: SPRING_PROFILES_ACTIVE=prod
