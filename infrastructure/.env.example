# Local development only. Generate secrets; never commit the completed .env.
DATABASE_PASSWORD=
JWT_SECRET=
# Enable for the first startup only. Disable and remove bootstrap password afterward.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=

# Persist this key with encrypted backups: openssl rand -base64 32
APP_SECRETS_ENCRYPTION_KEY=
PRIVACY_POLICY_URL=
TERMS_URL=
PRIVACY_CONTACT_EMAIL=
CLINIC_LEGAL_NAME=
RETENTION_NOTICE=
# Production only; use actual DNS names, without https://
API_DOMAIN=
DASHBOARD_DOMAIN=
ACME_EMAIL=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
APP_MAIL_FROM=
